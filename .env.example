# Telegram Bot Configuration
# Copy this file to .env and fill in your values

# Your Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Comma-separated list of Telegram User IDs allowed to use the bot
# Leave empty to allow all users
# Example: 123456789,987654321
ALLOWED_USER_IDS=

# Optional: Default volume (25, 50, 75, or 100)
DEFAULT_VOLUME=75

# Optional: Enable debug logging (true/false)
DEBUG=false

# Optional: Enable YouTube suggestions when queue finishes (true/false)
# Default: true (fetches YouTube related videos when playlist ends)
# Set to false to use auto-loop playlist instead
ENABLE_YOUTUBE_SUGGESTIONS=true

# ============================================================================
# YouTube Cookies Configuration (PENTING untuk menghindari bot detection!)
# ============================================================================

# Method 1: Cookies File (RECOMMENDED - Lebih Stabil)
# Export cookies dari Chrome menggunakan extension "Get cookies.txt LOCALLY"
# Simpan file cookies.txt di root folder project
# Atau gunakan path absolut: C:/path/to/cookies.txt
YOUTUBE_COOKIES_FILE=cookies.txt

# Method 2: Auto Extract dari Browser (Alternative)
# Hanya jika tidak pakai cookies file
# Supported: chrome, firefox, edge, safari, opera, brave
# Kosongkan jika sudah pakai YOUTUBE_COOKIES_FILE
COOKIES_FROM_BROWSER=
