[Unit]
Description=YouTube Music Telegram Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jhopan
Group=jhopan
WorkingDirectory=/home/jhopan/Play-Youtube-In-CLI
ExecStart=/home/jhopan/Play-Youtube-In-CLI/venv/bin/python /home/jhopan/Play-Youtube-In-CLI/main.py

# Restart otomatis kalau crash
Restart=always
RestartSec=10

# Environment
Environment=PYTHONUNBUFFERED=1

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ytmusic-bot

[Install]
WantedBy=multi-user.target
